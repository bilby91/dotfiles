{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash

# Add taps first
{{ range .packages.darwin.taps -}}
brew tap {{ . | quote }}
{{ end -}}

# Install packages
brew bundle install --file=/dev/stdin <<EOF
{{ range .packages.darwin.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range .packages.darwin.casks -}}
cask {{ . | quote }}
{{ end -}}
EOF
{{ end -}}
